# Copy to .env and adjust.

# Where your videos are on this machine (mounted read-only at /media).
MEDIA_PATH=/mnt/nas/videos

# Where Reel keeps its database, thumbnails and uploaded images.
DATA_PATH=./data

# The user/group the container runs as: must be able to read MEDIA_PATH and
# write DATA_PATH. Find yours with `id`.
PUID=1000
PGID=1000

# Port on this machine.
REEL_PORT=8000

# ffmpeg release series baked into the image: "auto" = the newest release
# (currently 9.0.x). To update ffmpeg: docker compose build --no-cache && docker compose up -d
FFMPEG_SERIES=auto

# Days a video stays (hidden, with its tags and images) after a scan stops finding
# it, before it's removed for good. Protects against a NAS that was briefly offline.
REEL_MISSING_GRACE_DAYS=7

# Where pictures may be downloaded from when you paste an image URL:
#   internet  public addresses only (default)
#   lan       also your local network (e.g. another homelab server)
#   off       no URL downloads
REEL_IMAGE_URLS=internet

# Videos that may be converted/repackaged at once (each uses an ffmpeg process).
# More viewers than this get a "try again in a moment" message.
REEL_MAX_STREAMS=3

# ffprobe processes run at once while scanning.
REEL_PROBE_WORKERS=4

# Only for the optional SMB volume in compose.yaml.
# SMB_USER=
# SMB_PASSWORD=
