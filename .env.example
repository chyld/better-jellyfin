# Copy to .env and adjust.

# Where your videos are on this machine (mounted read-only at /media).
MEDIA_PATH=/mnt/nas/videos

# Where Reel keeps its database, thumbnails and uploaded images.
DATA_PATH=./data

# The user/group the container runs as: must be able to read MEDIA_PATH and
# write DATA_PATH. Find yours with `id`.
PUID=1000
PGID=1000

# Port on this machine.
REEL_PORT=8000

# ffmpeg release series baked into the image: "auto" = the newest release
# (currently 9.0.x). To update ffmpeg: docker compose build --no-cache && docker compose up -d
FFMPEG_SERIES=auto

# ffprobe processes run at once while scanning.
REEL_PROBE_WORKERS=4

# Only for the optional SMB volume in compose.yaml.
# SMB_USER=
# SMB_PASSWORD=
